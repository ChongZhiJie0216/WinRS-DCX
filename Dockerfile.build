# Cross-compile duinodcx for OpenWRT / iStoreOS (static musl binaries).
# Used by scripts/cross-build.sh. The UI is already built and tracked in git
# (node_modules/dcx-ui/dist), so Node.js is not needed here.
FROM rust:1.90-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# Zig is the C toolchain/linker used by cargo-zigbuild
RUN curl -fsSL https://ziglang.org/download/0.13.0/zig-linux-x86_64-0.13.0.tar.xz | tar -xJ -C /opt
ENV PATH="/opt/zig-linux-x86_64-0.13.0:${PATH}"

RUN rustup target add \
    aarch64-unknown-linux-musl \
    armv7-unknown-linux-musleabihf \
    x86_64-unknown-linux-musl

RUN cargo install --locked cargo-zigbuild

WORKDIR /app

ENV TARGET=aarch64-unknown-linux-musl
CMD cargo zigbuild --release -p duinodcx-management --target "$TARGET"
